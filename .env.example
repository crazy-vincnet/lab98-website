# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# All server-only: do NOT prefix with NEXT_PUBLIC_.

# InsForge project URL (oss_host in .insforge/project.json)
INSFORGE_URL=https://sg8srf86.ap-southeast.insforge.app
# InsForge project admin API key (ik_…). Full access — keep secret.
# Get it with: npx -y @insforge/cli secrets get API_KEY
INSFORGE_API_KEY=
# Team inbox that receives new-inquiry notifications
CONTACT_NOTIFY_EMAIL=
# Any long random string, used to hash visitor IPs for rate limiting
# e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INQUIRY_IP_SALT=

# --- Admin (/admin) ---------------------------------------------------------------
# Auth SDK settings. The anon key is public by design (it is sent to browsers); it is NOT the admin key.
# Get it with: npx -y @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=https://sg8srf86.ap-southeast.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Who may use /admin (comma-separated, lowercase). Signup on the project is open, so this list is what makes an admin.
ADMIN_EMAILS=youngjae1009@gmail.com

# Search-console ownership verification: FALLBACK only (optional).
# Normally set in /admin/search (stored in the database, no redeploy needed); these apply when the DB has no value.
# Value = the content="…" token only, not the whole tag.
# Google Search Console → Settings → Ownership verification → HTML tag
GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor (searchadvisor.naver.com) → 사이트 등록 → HTML 태그
NAVER_SITE_VERIFICATION=
